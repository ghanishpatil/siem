# ──────────────────────────────────────────────────────────────────────────────
# SentinelX SIEM — Backend Configuration
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` and adjust values. `.env` is git-ignored.
# All keys use the SIEM_ prefix. Never commit real secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Environment ──────────────────────────────────────────────────────────────
# "development" (default) or "production"
SIEM_ENVIRONMENT=development

# ── Server ───────────────────────────────────────────────────────────────────
# Host and port the backend binds to.
# Change SIEM_PORT to run on a different port (e.g. 9000).
# If you change this, also update VITE_BACKEND_PORT in the frontend .env.
SIEM_HOST=127.0.0.1
SIEM_PORT=8000

# ── Database ─────────────────────────────────────────────────────────────────
# SQLAlchemy URL. Relative SQLite path (default) works for local dev.
SIEM_DATABASE_URL=sqlite:///./sentinelx.db
#
# Production (absolute path on a mounted volume):
#   SIEM_DATABASE_URL=sqlite:////data/sentinelx.db

# ── CORS ─────────────────────────────────────────────────────────────────────
# Allowed origins. Defaults to localhost:5173 and localhost:3000 when unset.
# Comma-separated or JSON array accepted.
#   SIEM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
#
# Production example:
#   SIEM_CORS_ORIGINS=https://your-frontend.vercel.app

# ── Ingestion Limits ─────────────────────────────────────────────────────────
# SIEM_MAX_BATCH_SIZE=1000
# SIEM_MAX_INGEST_BYTES=5000000
# SIEM_MAX_UPLOAD_BYTES=10000000
# SIEM_MAX_JSONL_RECORDS=10000

# ── Detection ────────────────────────────────────────────────────────────────
# Max events the correlation engine scans per evaluation.
# SIEM_MAX_EVENTS_SCAN=100000
