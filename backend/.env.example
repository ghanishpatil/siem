# SentinelX SIEM backend configuration.
# Copy to `.env` for local use and adjust as needed. `.env` is git-ignored.
# All application keys use the SIEM_ prefix. Use placeholders only — never
# commit real secrets.

# ---------------------------------------------------------------------------
# Environment: "development" (default) or "production".
# In production the app refuses to start on an ephemeral SQLite path (see
# SIEM_DATABASE_URL below) — it will not silently fall back to a throwaway DB.
# ---------------------------------------------------------------------------
SIEM_ENVIRONMENT=development

# ---------------------------------------------------------------------------
# Database (SQLAlchemy URL).
# Local development (relative path, lives in the backend working directory):
SIEM_DATABASE_URL=sqlite:///./sentinelx.db
#
# Production on Railway MUST use an absolute path on a mounted persistent
# volume. Note the FOUR slashes after "sqlite:" for an absolute path. Example
# for a volume mounted at /data:
#   SIEM_DATABASE_URL=sqlite:////data/sentinelx.db
# The app creates the parent directory if needed; if the volume is missing or
# unwritable, startup fails loudly rather than using an ephemeral database.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# CORS allowed origins. Accepts either a comma-separated list (recommended on
# Railway) or a JSON array. Defaults to the local Vite dev server when unset.
# Comma-separated (production example — set to your Vercel frontend origin):
#   SIEM_CORS_ORIGINS=https://your-frontend.vercel.app
# Multiple origins (e.g. production + a preview domain):
#   SIEM_CORS_ORIGINS=https://your-frontend.vercel.app,https://preview.your-frontend.vercel.app
# JSON array form is also accepted:
#   SIEM_CORS_ORIGINS=["https://your-frontend.vercel.app"]
# Do not use "*" in production. The API is cookie/token-free, so credentialed
# CORS is disabled.
# ---------------------------------------------------------------------------
# SIEM_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# PORT: provided automatically by Railway and consumed by the start command
# (uvicorn ... --host 0.0.0.0 --port $PORT). It is NOT a SIEM_ setting and does
# not need to be set here. Locally the app is run with an explicit port.
# ---------------------------------------------------------------------------
