# ──────────────────────────────────────────────────────────────────────────────
# SentinelX SIEM — Frontend Configuration (Vite)
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to `.env` or `.env.local`. These files are git-ignored.
# Only VITE_-prefixed variables are exposed to the browser — NEVER put secrets.
# ──────────────────────────────────────────────────────────────────────────────

# ── Ports ────────────────────────────────────────────────────────────────────
# Frontend dev server port (default: 5173)
VITE_PORT=5173

# Backend port the Vite proxy forwards /api requests to (default: 8000).
# Must match SIEM_PORT in the backend .env.
VITE_BACKEND_PORT=8000

# ── API Base URL (production only) ──────────────────────────────────────────
# Leave UNSET for local development — Vite proxies /api to the backend.
# For production (Vercel), set to the backend origin WITHOUT trailing /api:
#   VITE_API_BASE_URL=https://your-backend.up.railway.app
